{
  "name": "salvage-heist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js --production",
    "build": "vite build && tsc -p tsconfig.server.json",
    "format": "biome check --write .",
    "lint": "biome check .",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:load": "tsx scripts/simulate-match.ts"
  },
  "dependencies": {
    "express": "5.2.1",
    "node": "24.21.0",
    "phaser": "4.2.1",
    "qrcode": "1.5.4",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "svelte": "5.57.1",
    "svelte-sonner": "1.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/qrcode": "1.5.6",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
